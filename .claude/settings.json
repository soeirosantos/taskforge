{
  "env": {
    "CLAUDE_CODE_ENABLE_TASKS": "1",

    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4318",
    "OTEL_METRIC_EXPORT_INTERVAL": "5000",

    "OTEL_RESOURCE_ATTRIBUTES": "experiment.arm=main,apparatus.sha=e6e3ab5"
  },
  "hooks": {
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/verify-unit-tests.sh\"",
            "timeout": 360
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/record-task-event.sh\"",
            "timeout": 360
          }
        ]
      }
    ]
  }
}
