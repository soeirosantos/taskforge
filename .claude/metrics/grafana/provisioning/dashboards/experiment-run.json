{
  "title": "Experiment Run",
  "uid": "taskforge-run",
  "tags": [
    "taskforge"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "arm",
        "label": "Experiment arm",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(claude_code_cost_usage_USD_total, experiment_arm)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Budget",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Total cost",
      "description": "Sum of claude_code_cost_usage_USD_total for the selected arm(s). This is the headline number: what the run cost.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 3,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max_over_time(claude_code_cost_usage_USD_total{experiment_arm=~\"$arm\"}[$__range]))",
          "legendFormat": "cost"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total tokens",
      "description": "All token types combined (input, output, cacheRead, cacheCreation).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max_over_time(claude_code_token_usage_tokens_total{experiment_arm=~\"$arm\"}[$__range]))",
          "legendFormat": "tokens"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Sessions",
      "description": "Distinct Claude Code sessions started. A high count relative to task count can mean sessions are being restarted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 10,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (session_id) (max_over_time(claude_code_session_count_total{experiment_arm=~\"$arm\"}[$__range])))",
          "legendFormat": "sessions"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Active time",
      "description": "claude_code_active_time_seconds_total \u2014 wall-clock time the agent was actively working.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 14,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max_over_time(claude_code_active_time_seconds_total{experiment_arm=~\"$arm\"}[$__range]))",
          "legendFormat": "active"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Lines changed",
      "description": "claude_code_lines_of_code_count_total. Useful as a sanity check: near-zero alongside passing tasks is a signal worth investigating.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max_over_time(claude_code_lines_of_code_count_total{experiment_arm=~\"$arm\"}[$__range]))",
          "legendFormat": "lines"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cumulative cost over the run",
      "description": "The shape matters more than the value. A steep late climb usually means an agent is spinning rather than converging.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (experiment_arm) (max_over_time(claude_code_cost_usage_USD_total{experiment_arm=~\"$arm\"}[10m]))",
          "legendFormat": "{{experiment_arm}}"
        }
      ]
    },
    {
      "type": "piechart",
      "title": "Cost by model",
      "description": "Which tier is actually spending. Heavy Opus share means escalation is being used more than the policy intends.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (max_over_time(claude_code_cost_usage_USD_total{experiment_arm=~\"$arm\"}[$__range]))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Tokens",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": "timeseries",
      "title": "Tokens by type",
      "description": "cacheRead climbing while input stays flat is healthy \u2014 it means prompt caching is working. Both climbing together is expensive.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (max_over_time(claude_code_token_usage_tokens_total{experiment_arm=~\"$arm\"}[10m]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Tokens by model",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (max_over_time(claude_code_token_usage_tokens_total{experiment_arm=~\"$arm\"}[$__range]))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Run identity",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      }
    },
    {
      "type": "table",
      "title": "Arms seen, with apparatus and CLI version",
      "description": "Every arm reporting metrics, with the controls commit and agent build it ran under. Rows with an empty arm were not launched through run-arm.sh and cannot be attributed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "sum by (experiment_arm, apparatus_sha, cli_version) (max_over_time(claude_code_cost_usage_USD_total{experiment_arm=~\"$arm\"}[$__range]))",
          "legendFormat": "{{experiment_arm}}"
        }
      ]
    }
  ]
}